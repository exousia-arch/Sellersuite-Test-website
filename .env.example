# Copy to .env.local for local work, and set the same names in Vercel (Settings > Environment Variables).
# NEVER commit real values. Production and Preview must use DIFFERENT Supabase projects and keys.

# Supabase (project settings > API). The URL and publishable (anon) key are safe for the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
# SECRET. Server-side functions only (api/*). Bypasses row level security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Existing settings (already configured in Vercel)
AUTH_SECRET=
PPCBENCH_USERS=
REQUEST_WEBHOOK=
NEWSLETTER_WEBHOOK=
CONTACT_WEBHOOK=
